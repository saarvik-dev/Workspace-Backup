/* 1. Global Styles */
body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    margin: 0;
    background-color: #f4f4f4;
    color: #333;
}

/* 2. Navigation Bar */
nav {
    background: #2c3e50;
    color: white;
    padding: 1rem;
    text-align: center;
}

nav a {
    color: white;
    text-decoration-line: none;
    margin: 0 15px ;
    font-weight: bold;
}

nav a:hover {
    color: #3498db;
}

/* 3. Main Layout (Flexbox) */
main {
    display: flex; /* This aligns <section> and <aside> side-by-side */
    max-width: 1000px;
    margin: 20px auto;
    gap: 20px;
    padding: 0 20px;
}

/* 4. Content Area */
section {
    flex: 3; /* Takes up 3/4 of the width */
    background: white;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

/* 5. Sidebar (The Aside) */
aside {
    flex: 1; /* Takes up 1/4 of the width */
    background: #ecf0f1;
    padding: 20px;
    border-radius: 8px;
    height: fit-content;
}

/* 6. Form Styling */
form div {
    margin-bottom: 15px;
}

label {
    display: block;
    font-weight: bold;
}

input {
    width: 100%;
    padding: 8px;
    margin-top: 5px;
    border: 1px solid #ccc;
    border-radius: 4px;
    box-sizing: border-box; /* Ensures padding doesn't break width */
}

button {
    background: #27ae60;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}

button:hover {
    background: #219150;
}

/* 7. Footer */
footer {
    text-align: center;
    padding: 20px;
    font-size: 0.8rem;
    color: #777;
}